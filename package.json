{
  "name": "space-travel-website",
  "version": "1.0.0",
  "description": "An immersive space tourism website showcasing destinations, crew members, and cutting-edge space technology. Built with HTML, CSS, and JavaScript.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm biome:check && pnpm test:run && pnpm build",
    "security": "pnpm audit --audit-level high",
    "audit": "pnpm audit --audit-level high"
  },
  "keywords": [
    "space",
    "tourism",
    "website",
    "vite",
    "portfolio"
  ],
  "author": "Elizabeth Stein",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/space-travel-website"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "jsdom": "^29.1.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "dependencies": {
    "three": "^0.185.1"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "undici": ">=7.28.0"
    }
  }
}
